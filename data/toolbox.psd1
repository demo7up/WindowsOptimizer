    @{ Group='TOOLS'; Name='Toolkit'; Id='toolkit'; Tasks=@(
      @{ Id='debloat_recommended'; Title='Debloat (Recommended)'; Desc='Apply the recommended privacy/debloat set: telemetry, ads, suggestions, and lock-screen spotlight off.'; Kind='run'; Admin=$true; Danger=$true; Cmd='Write-Host ''Applying recommended debloat...''; Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo'' -Name Enabled -Value 0 -Type DWord -Force -EA SilentlyContinue; Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'' -Name ShowSyncProviderNotifications -Value 0 -Type DWord -EA SilentlyContinue; $cdm=''HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager''; ''SubscribedContent-338387Enabled'',''SubscribedContent-338388Enabled'',''SubscribedContent-338389Enabled'',''SystemPaneSuggestionsEnabled'',''RotatingLockScreenOverlayEnabled'' | ForEach-Object { Set-ItemProperty $cdm -Name $_ -Value 0 -Type DWord -EA SilentlyContinue }; New-Item ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection'' -Force | Out-Null; Set-ItemProperty ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection'' -Name AllowTelemetry -Value 0 -Type DWord -EA SilentlyContinue; Set-Service DiagTrack -StartupType Disabled -EA SilentlyContinue; Stop-Service DiagTrack -Force -EA SilentlyContinue; Write-Host ''Recommended debloat applied.'' -ForegroundColor Green' }
      @{ Id='remove_common_bloatware'; Title='Remove Common Bloatware'; Desc='Uninstall common preinstalled apps (Candy Crush, Xbox, News, Weather, Clipchamp, etc.).'; Kind='run'; Admin=$true; Danger=$true; Cmd='$apps=''Microsoft.549981C3F5F10'',''king.com.CandyCrush*'',''Microsoft.BingNews'',''Microsoft.BingWeather'',''Microsoft.GetHelp'',''Microsoft.Getstarted'',''Microsoft.MicrosoftSolitaireCollection'',''Microsoft.People'',''Microsoft.WindowsFeedbackHub'',''Microsoft.Xbox.TCUI'',''Microsoft.XboxGamingOverlay'',''Microsoft.XboxIdentityProvider'',''Microsoft.XboxSpeechToTextOverlay'',''Microsoft.ZuneMusic'',''Microsoft.ZuneVideo'',''Microsoft.MixedReality.Portal'',''Microsoft.SkypeApp'',''Microsoft.Todos'',''Clipchamp.Clipchamp'',''MicrosoftTeams'',''*Disney*'',''*Spotify*''; foreach($a in $apps){ Get-AppxPackage -AllUsers $a -EA SilentlyContinue | Remove-AppxPackage -AllUsers -EA SilentlyContinue }; Write-Host ''Common bloatware removed.'' -ForegroundColor Green' }
      @{ Id='list_removable_apps'; Title='List Installed Apps'; Desc='List all installed UWP/Store apps (for targeted removal).'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-AppxPackage | Select-Object Name, PackageFullName | Sort-Object Name | Format-Table -AutoSize | Out-String' }
      @{ Id='uninstall_program'; Title='Uninstall a Program'; Desc='Silently uninstall a program by name via winget.'; Kind='run'; Admin=$true; Danger=$false; Cmd='winget uninstall --name ''{{name}}'' --silent --accept-source-agreements'; Inputs=@(@{ Key='name'; Label='Program name (as shown in winget list)'; Placeholder='Spotify' }) }
      @{ Id='system_report'; Title='System Report'; Desc='Generate a branded HTML system report (specs, OS, disks, GPU) and open it.'; Kind='run'; Admin=$false; Danger=$false; Cmd='$p="$env:USERPROFILE\Desktop\WindowsOptimizer-System-Report.html"; $style="<style>body{font-family:Segoe UI,Arial,sans-serif;background:#0f1013;color:#e8eaf0;margin:0;padding:32px}h1{color:#ff2d46;margin:0}h2{color:#ff6577;border-bottom:1px solid #2a2a30;padding-bottom:6px;margin-top:26px}table{border-collapse:collapse;width:100%;margin-top:8px}td,th{border:1px solid #2a2a30;padding:6px 10px;text-align:left;font-size:13px}th{background:#17171c;color:#fff}.hdr{color:#7d818c;font-size:12px;margin-bottom:10px}</style>"; $os=Get-CimInstance Win32_OperatingSystem; $cs=Get-CimInstance Win32_ComputerSystem; $cpu=Get-CimInstance Win32_Processor | Select-Object -First 1; $b1=$cs | Select-Object @{n=''Host'';e={$env:COMPUTERNAME}},Manufacturer,Model,@{n=''RAM (GB)'';e={[math]::Round($_.TotalPhysicalMemory/1GB)}} | ConvertTo-Html -Fragment -PreContent ''<h2>System</h2>''; $b2=$os | Select-Object Caption,Version,BuildNumber,OSArchitecture | ConvertTo-Html -Fragment -PreContent ''<h2>Operating System</h2>''; $b3=$cpu | Select-Object Name,NumberOfCores,NumberOfLogicalProcessors,MaxClockSpeed | ConvertTo-Html -Fragment -PreContent ''<h2>Processor</h2>''; $b4=Get-CimInstance Win32_VideoController | Select-Object Name,DriverVersion | ConvertTo-Html -Fragment -PreContent ''<h2>Graphics</h2>''; $b5=Get-CimInstance Win32_LogicalDisk -Filter ''DriveType=3'' | Select-Object DeviceID,@{n=''Size (GB)'';e={[math]::Round($_.Size/1GB)}},@{n=''Free (GB)'';e={[math]::Round($_.FreeSpace/1GB)}} | ConvertTo-Html -Fragment -PreContent ''<h2>Disks</h2>''; $hdr="<h1>WindowsOptimizer &mdash; System Report</h1><div class=''hdr''>WindowsOptimizer &middot; $(Get-Date)</div>"; ConvertTo-Html -Head $style -Title ''WindowsOptimizer System Report'' -Body ($hdr+$b1+$b2+$b3+$b4+$b5) | Out-File -Encoding utf8 $p; Start-Process $p; Write-Host "Report saved to $p" -ForegroundColor Green' }
      @{ Id='client_report'; Title='Client Report (PDF)'; Desc='Generate a branded, client-ready PDF system report (via Edge) and open it.'; Kind='run'; Admin=$false; Danger=$false; Cmd='$html="$env:TEMP\WindowsOptimizer-client-report.html"; $pdf="$env:USERPROFILE\Desktop\WindowsOptimizer-System-Report.pdf"; $style="<style>body{font-family:Segoe UI,Arial,sans-serif;color:#1a1d24;margin:0;padding:36px}h1{color:#c20e22;margin:0;font-size:24px}.sub{color:#6b7280;font-size:12px;margin:4px 0 18px}h2{color:#c20e22;font-size:15px;border-bottom:2px solid #eee;padding-bottom:5px;margin-top:22px}table{border-collapse:collapse;width:100%;margin-top:6px}td,th{border:1px solid #e5e7eb;padding:6px 10px;text-align:left;font-size:12.5px}th{background:#f7f7f9}</style>"; $os=Get-CimInstance Win32_OperatingSystem; $cs=Get-CimInstance Win32_ComputerSystem; $cpu=Get-CimInstance Win32_Processor | Select-Object -First 1; $b1=$cs | Select-Object @{n=''Hostname'';e={$env:COMPUTERNAME}},Manufacturer,Model,@{n=''RAM (GB)'';e={[math]::Round($_.TotalPhysicalMemory/1GB)}} | ConvertTo-Html -Fragment -PreContent ''<h2>System</h2>''; $b2=$os | Select-Object Caption,Version,BuildNumber,OSArchitecture | ConvertTo-Html -Fragment -PreContent ''<h2>Operating System</h2>''; $b3=$cpu | Select-Object Name,NumberOfCores,NumberOfLogicalProcessors | ConvertTo-Html -Fragment -PreContent ''<h2>Processor</h2>''; $b4=Get-CimInstance Win32_VideoController | Select-Object Name,DriverVersion | ConvertTo-Html -Fragment -PreContent ''<h2>Graphics</h2>''; $b5=Get-CimInstance Win32_LogicalDisk -Filter ''DriveType=3'' | Select-Object DeviceID,@{n=''Size (GB)'';e={[math]::Round($_.Size/1GB)}},@{n=''Free (GB)'';e={[math]::Round($_.FreeSpace/1GB)}} | ConvertTo-Html -Fragment -PreContent ''<h2>Storage</h2>''; $hdr="<h1>WindowsOptimizer &mdash; System Report</h1><div class=''sub''>Prepared by WindowsOptimizer &middot; $(Get-Date -Format ''MMMM d, yyyy h:mm tt'')</div>"; ConvertTo-Html -Head $style -Title ''WindowsOptimizer System Report'' -Body ($hdr+$b1+$b2+$b3+$b4+$b5) | Out-File -Encoding utf8 $html; $edge=(Get-ItemProperty ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\msedge.exe'' -EA SilentlyContinue).''(default)''; if(-not $edge -or -not (Test-Path $edge)){ $edge=''C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'' }; if(Test-Path $edge){ & $edge --headless=new --disable-gpu "--print-to-pdf=$pdf" ("file:///"+$html.Replace(''\'',''/'')) 2>$null; Start-Sleep -Seconds 3; if(Test-Path $pdf){ Start-Process $pdf; Write-Host "PDF saved to $pdf" -ForegroundColor Green } else { Start-Process $html; Write-Host ''PDF generation failed; opened the HTML instead.'' -ForegroundColor Yellow } } else { Start-Process $html; Write-Host ''Edge not found; opened the HTML report.'' -ForegroundColor Yellow }' }
      @{ Id='disk_health'; Title='Disk Health (SMART)'; Desc='Physical disk health and status.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-PhysicalDisk | Select-Object FriendlyName,MediaType,@{n=''Size(GB)'';e={[math]::Round($_.Size/1GB)}},HealthStatus,OperationalStatus | Format-Table -AutoSize | Out-String' }
      @{ Id='disk_space_top'; Title='Top Space Users'; Desc='Largest top-level folders on C: (may take a moment).'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-ChildItem C:\ -Directory -Force -EA SilentlyContinue | ForEach-Object { $s=(Get-ChildItem $_.FullName -Recurse -File -Force -EA SilentlyContinue | Measure-Object Length -Sum).Sum; [pscustomobject]@{ Folder=$_.Name; ''Size(GB)''=[math]::Round($s/1GB,2) } } | Sort-Object ''Size(GB)'' -Descending | Select-Object -First 15 | Format-Table -AutoSize | Out-String' }
      @{ Id='large_files'; Title='Find Large Files'; Desc='Largest 25 files under a folder.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-ChildItem ''{{path}}'' -Recurse -File -Force -EA SilentlyContinue | Sort-Object Length -Descending | Select-Object -First 25 @{n=''MB'';e={[math]::Round($_.Length/1MB,1)}},FullName | Format-Table -AutoSize | Out-String'; Inputs=@(@{ Key='path'; Label='Folder'; Placeholder='C:\Users' }) }
      @{ Id='crash_report'; Title='Crash / BSOD Report'; Desc='Recent critical/error events and minidumps.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Write-Host ''== Recent critical/error events ==''; Get-WinEvent -FilterHashtable @{LogName=''System'';Level=1,2} -MaxEvents 20 -EA SilentlyContinue | Format-Table TimeCreated,Id,ProviderName -AutoSize | Out-String; Write-Host ''== Minidumps ==''; Get-ChildItem ''C:\Windows\Minidump\*.dmp'' -EA SilentlyContinue | Select-Object Name,LastWriteTime,@{n=''KB'';e={[math]::Round($_.Length/1KB)}} | Format-Table -AutoSize | Out-String' }
      @{ Id='active_connections'; Title='Active Connections'; Desc='Established TCP connections and owning processes.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-NetTCPConnection -State Established -EA SilentlyContinue | Select-Object LocalAddress,LocalPort,RemoteAddress,RemotePort,@{n=''Process'';e={(Get-Process -Id $_.OwningProcess -EA SilentlyContinue).ProcessName}} | Sort-Object RemoteAddress | Format-Table -AutoSize | Out-String' }
      @{ Id='traceroute'; Title='Traceroute'; Desc='Trace the route to a host.'; Kind='report'; Admin=$false; Danger=$false; Cmd='tracert -d ''{{host}}'''; Inputs=@(@{ Key='host'; Label='Host / IP'; Placeholder='1.1.1.1' }) }
      @{ Id='dns_lookup'; Title='DNS Lookup'; Desc='Resolve a hostname.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Resolve-DnsName ''{{host}}'' | Format-Table -AutoSize | Out-String'; Inputs=@(@{ Key='host'; Label='Hostname'; Placeholder='example.com' }) }
      @{ Id='port_check'; Title='Port Check'; Desc='Test whether a TCP port is open on a host.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Test-NetConnection -ComputerName ''{{host}}'' -Port {{port}} | Select-Object ComputerName,RemotePort,TcpTestSucceeded,PingSucceeded | Format-List'; Inputs=@(@{ Key='host'; Label='Host / IP'; Placeholder='192.168.1.1' }, @{ Key='port'; Label='Port'; Placeholder='443' }) }
      @{ Id='wifi_passwords'; Title='Wi-Fi Passwords'; Desc='Show saved Wi-Fi network names and passwords.'; Kind='report'; Admin=$true; Danger=$false; Cmd='(netsh wlan show profiles) | Select-String ''All User Profile\s*:\s(.+)$'' | ForEach-Object { $n=$_.Matches.Groups[1].Value.Trim(); $k=((netsh wlan show profile name="$n" key=clear) | Select-String ''Key Content\s*:\s(.+)$''); $pw=if($k){$k.Matches.Groups[1].Value.Trim()}else{''(none)''}; [pscustomobject]@{ SSID=$n; Password=$pw } } | Format-Table -AutoSize | Out-String' }
      @{ Id='windows_update_history'; Title='Update History'; Desc='Recently installed updates/hotfixes.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-HotFix | Sort-Object InstalledOn -Descending | Select-Object -First 25 HotFixID,Description,InstalledOn | Format-Table -AutoSize | Out-String' }
      @{ Id='pause_updates'; Title='Pause Updates 7 Days'; Desc='Pause Windows Update for one week.'; Kind='run'; Admin=$true; Danger=$false; Cmd='$d=(Get-Date).AddDays(7).ToUniversalTime().ToString(''yyyy-MM-ddTHH:mm:ssZ''); $k=''HKLM:\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings''; New-Item $k -Force | Out-Null; Set-ItemProperty $k -Name PauseUpdatesExpiryTime -Value $d; Set-ItemProperty $k -Name PauseFeatureUpdatesEndTime -Value $d -EA SilentlyContinue; Set-ItemProperty $k -Name PauseQualityUpdatesEndTime -Value $d -EA SilentlyContinue; Write-Host "Updates paused until $d" -ForegroundColor Green' }
      @{ Id='resume_updates'; Title='Resume Updates'; Desc='Remove the Windows Update pause.'; Kind='run'; Admin=$true; Danger=$false; Cmd='$k=''HKLM:\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings''; ''PauseUpdatesExpiryTime'',''PauseFeatureUpdatesEndTime'',''PauseQualityUpdatesEndTime'' | ForEach-Object { Remove-ItemProperty $k -Name $_ -EA SilentlyContinue }; Write-Host ''Updates resumed.'' -ForegroundColor Green' }
    ) }
