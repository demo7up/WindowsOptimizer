      @{ Id='run_windows_memory_diagnostic'; Title='Memory Diagnostic'; Desc='Schedule the Windows Memory Diagnostic (reboots).'; Kind='launch'; Admin=$true; Danger=$true; Cmd='Start-Process mdsched.exe' }
