      @{ Id='unhide_file_folder'; Title='Unhide Item'; Desc='Remove the hidden attribute from a path.'; Kind='run'; Admin=$false; Danger=$false; Cmd='attrib -h ''{{path}}''; Write-Host ''Item unhidden.'' -ForegroundColor Green'; Inputs=@(@{ Key='path'; Label='File or folder path'; Placeholder='C:\path\to\item' }) }
