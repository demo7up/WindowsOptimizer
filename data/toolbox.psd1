      @{ Id='gpu_information'; Title='GPU Information'; Desc='Graphics adapter details.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-CimInstance Win32_VideoController | Select-Object Name,DriverVersion,VideoProcessor,@{n=''Resolution'';e={"$($_.CurrentHorizontalResolution)x$($_.CurrentVerticalResolution)"}} | Format-List; Write-Host ''VRAM (from registry):''; Get-ChildItem ''HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}'' -EA SilentlyContinue | ForEach-Object { $p=Get-ItemProperty $_.PSPath -EA SilentlyContinue; if($p.''HardwareInformation.qwMemorySize''){ Write-Host (''  '' + $p.DriverDesc + '': '' + [math]::Round($p.''HardwareInformation.qwMemorySize''/1GB,1) + '' GB'') } }' }
      @{ Id='view_user_information'; Title='User Information'; Desc='Local users and current group membership.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-LocalUser | Format-Table Name,Enabled,LastLogon -AutoSize | Out-String; whoami /groups' }
      @{ Id='list_installed_drivers'; Title='Installed Drivers'; Desc='List signed device drivers.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-CimInstance Win32_PnPSignedDriver | Select-Object DeviceName,DriverVersion,Manufacturer | Where-Object DeviceName | Sort-Object DeviceName | Format-Table -AutoSize | Out-String' }
      @{ Id='list_installed_programs'; Title='Installed Programs'; Desc='List installed applications.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Get-ItemProperty ''HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*'',''HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'' -ErrorAction SilentlyContinue | Select-Object DisplayName,DisplayVersion,Publisher | Where-Object DisplayName | Sort-Object DisplayName | Format-Table -AutoSize | Out-String' }
