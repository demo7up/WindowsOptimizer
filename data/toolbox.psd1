    @{ Group='SYSTEM'; Name='Diagnostics'; Id='diagnostics'; Tasks=@(
      @{ Id='check_specifications'; Title='Check Specifications'; Desc='Summary of CPU, RAM, GPU and OS.'; Kind='report'; Admin=$false; Danger=$false; Cmd='$os=Get-CimInstance Win32_OperatingSystem; $cpu=Get-CimInstance Win32_Processor; $gpu=Get-CimInstance Win32_VideoController; Write-Host ''OS      :'' $os.Caption $os.Version; Write-Host ''CPU     :'' $cpu.Name; Write-Host ''Cores   :'' $cpu.NumberOfCores ''physical /'' $cpu.NumberOfLogicalProcessors ''logical''; Write-Host (''RAM     : {0:N1} GB'' -f ($os.TotalVisibleMemorySize/1MB)); ($gpu | ForEach-Object { Write-Host ''GPU     :'' $_.Name })' }
