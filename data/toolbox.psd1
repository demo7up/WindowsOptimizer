      @{ Id='unpin_program'; Title='Unpin from Taskbar'; Desc='Unpin an executable from the taskbar (best effort).'; Kind='run'; Admin=$false; Danger=$false; Cmd='$p=''{{path}}''; try { $sh=New-Object -ComObject shell.application; $i=$sh.Namespace((Split-Path $p)).ParseName((Split-Path $p -Leaf)); $i.InvokeVerb(''taskbarunpin'') } catch {}; Write-Host ''Note: Windows 11 restricts programmatic taskbar unpinning. If nothing changed, unpin manually via right-click.'' -ForegroundColor Yellow'; Inputs=@(@{ Key='path'; Label='Path to .exe'; Placeholder='C:\path\app.exe' }) }
