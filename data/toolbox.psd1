<#
    toolbox.psd1 - Repair & maintenance tasks (house-style data file).
    Migrated from the AbleTP Toolbox task registry and rebranded for WindowsOptimizer.
    Kinds: run | launch | report | toggle | special.
#>
@{
  Groups = @(
    @{ Group='REPAIR'; Name='Core Repair'; Id='repair'; Tasks=@(
      @{ Id='deep_fix'; Title='Deep Fix'; Desc='Full guided sequence: clear temp ? flush DNS ? DISM RestoreHealth ? SFC ? component cleanup.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Write-Host ''== Deep Fix =='' -ForegroundColor Cyan; Write-Host ''[1/6] Clearing user temp...''; Get-ChildItem $env:TEMP -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''[2/6] Clearing Windows temp...''; Get-ChildItem ''C:\Windows\Temp'' -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''[3/6] Flushing DNS...''; Clear-DnsClientCache; Write-Host ''[4/6] DISM RestoreHealth...''; DISM /Online /Cleanup-Image /RestoreHealth; Write-Host ''[5/6] SFC scannow...''; sfc /scannow; Write-Host ''[6/6] Component cleanup...''; DISM /Online /Cleanup-Image /StartComponentCleanup; Write-Host ''Deep Fix complete. A restart is recommended.'' -ForegroundColor Green' }
      @{ Id='quick_fix'; Title='Quick Fix'; Desc='Lighter pass: clear temp, flush DNS, restart Explorer.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Write-Host ''Quick Fix...''; Get-ChildItem $env:TEMP -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Clear-DnsClientCache; Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue; Start-Process explorer; Write-Host ''Quick Fix complete.'' -ForegroundColor Green' }
      @{ Id='run_dism_restorehealth'; Title='DISM RestoreHealth'; Desc='Repair the Windows component store online.'; Kind='run'; Admin=$true; Danger=$false; Cmd='DISM /Online /Cleanup-Image /RestoreHealth' }
      @{ Id='run_sfc'; Title='Run SFC'; Desc='Scan and repair protected system files.'; Kind='run'; Admin=$true; Danger=$false; Cmd='sfc /scannow' }
      @{ Id='check_disk'; Title='Check Disk'; Desc='Online scan of the C: volume for errors.'; Kind='run'; Admin=$true; Danger=$false; Cmd='chkdsk C: /scan' }
      @{ Id='fix_windows_apps'; Title='Fix Windows Apps'; Desc='Re-register Store, Start Menu and built-in packages.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Get-AppxPackage -AllUsers | ForEach-Object { Add-AppxPackage -DisableDevelopmentMode -Register "$($_.InstallLocation)\AppxManifest.xml" -ErrorAction SilentlyContinue }; Write-Host ''Built-in apps re-registered.'' -ForegroundColor Green' }
      @{ Id='reset_secure_channel'; Title='Reset Secure Channel'; Desc='Repair the machine''s domain secure channel.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Test-ComputerSecureChannel -Repair -Verbose' }
      @{ Id='update_group_policy'; Title='Update Group Policy'; Desc='Force a Group Policy refresh (gpupdate /force).'; Kind='run'; Admin=$false; Danger=$false; Cmd='gpupdate /force' }
      @{ Id='activate_self_healing_mode'; Title='Self-Healing Mode'; Desc='Run a full component health scan and enable automatic maintenance.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Write-Host ''Scanning component health...''; DISM /Online /Cleanup-Image /ScanHealth; Write-Host ''Verifying system files...''; sfc /verifyonly; schtasks /Change /TN ''\Microsoft\Windows\TaskScheduler\Regular Maintenance'' /ENABLE 2>$null; Write-Host ''Self-healing scan complete.'' -ForegroundColor Green' }
      @{ Id='reset_to_default_settings'; Title='Reset Core Settings'; Desc='Reset Winsock, TCP/IP, firewall and Windows Update components to defaults.'; Kind='run'; Admin=$true; Danger=$true; Cmd='netsh winsock reset; netsh int ip reset; netsh advfirewall reset; net stop wuauserv; net stop bits; Remove-Item ''C:\Windows\SoftwareDistribution\Download\*'' -Recurse -Force -ErrorAction SilentlyContinue; net start wuauserv; net start bits; ipconfig /flushdns; Write-Host ''Core settings reset. Restart recommended.'' -ForegroundColor Green' }
      @{ Id='check_windows_updates'; Title='Check for Updates'; Desc='Trigger a Windows Update scan.'; Kind='run'; Admin=$true; Danger=$false; Cmd='UsoClient StartScan; Write-Host ''Windows Update scan triggered ? see Settings > Windows Update.'' -ForegroundColor Green' }
      @{ Id='full_windows_update_reset'; Title='Full Windows Update Reset'; Desc='Stop services, clear SoftwareDistribution + catroot2, re-register WU components, reset Winsock.'; Kind='run'; Admin=$true; Danger=$true; Cmd='Write-Host ''Resetting Windows Update...''; net stop wuauserv; net stop bits; net stop cryptsvc; net stop msiserver; Remove-Item ''C:\Windows\SoftwareDistribution\*'' -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item ''C:\Windows\System32\catroot2\*'' -Recurse -Force -ErrorAction SilentlyContinue; ''wuaueng.dll'',''wups.dll'',''wups2.dll'',''wuwebv.dll'',''wucltux.dll'' | ForEach-Object { regsvr32 /s $_ }; netsh winsock reset; net start cryptsvc; net start bits; net start wuauserv; net start msiserver; Write-Host ''Windows Update reset complete. Restart recommended.'' -ForegroundColor Green' }
      @{ Id='rebuild_wmi_repository'; Title='Rebuild WMI Repository'; Desc='Verify and salvage the WMI repository (fixes corruption that breaks updates, Defender, reports).'; Kind='run'; Admin=$true; Danger=$true; Cmd='Write-Host ''Verifying WMI repository...''; winmgmt /verifyrepository; Write-Host ''Salvaging...''; winmgmt /salvagerepository; Write-Host ''WMI repository verified/salvaged.'' -ForegroundColor Green' }
      @{ Id='reset_windows_search'; Title='Reset Windows Search'; Desc='Rebuild the Windows Search index (fixes Start-menu search returning nothing).'; Kind='run'; Admin=$true; Danger=$false; Cmd='Stop-Service WSearch -Force -ErrorAction SilentlyContinue; Set-ItemProperty ''HKLM:\SOFTWARE\Microsoft\Windows Search'' -Name SetupCompletedSuccessfully -Value 0 -Type DWord -ErrorAction SilentlyContinue; Start-Service WSearch -ErrorAction SilentlyContinue; Write-Host ''Search index is rebuilding (may take a while).'' -ForegroundColor Green' }
      @{ Id='clear_print_queue'; Title='Clear Print Queue'; Desc='Stop the spooler, delete stuck print jobs, and restart it.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Stop-Service Spooler -Force; Remove-Item "$env:SystemRoot\System32\spool\PRINTERS\*" -Force -ErrorAction SilentlyContinue; Start-Service Spooler; Write-Host ''Print queue cleared and spooler restarted.'' -ForegroundColor Green' }
      @{ Id='force_time_resync'; Title='Force Time Resync'; Desc='Fix a wrong clock (causes cert/HTTPS/login failures) by resyncing to time.windows.com.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Start-Service w32time -ErrorAction SilentlyContinue; w32tm /config /manualpeerlist:''time.windows.com'' /syncfromflags:manual /update; Restart-Service w32time -ErrorAction SilentlyContinue; w32tm /resync /force; Write-Host ''Time resynced.'' -ForegroundColor Green' }
      @{ Id='rebuild_icon_cache'; Title='Rebuild Icon Cache'; Desc='Fix corrupted/blank icons by clearing the icon cache and restarting Explorer.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue; Remove-Item "$env:LOCALAPPDATA\IconCache.db" -Force -ErrorAction SilentlyContinue; Remove-Item "$env:LOCALAPPDATA\Microsoft\Windows\Explorer\iconcache*" -Force -ErrorAction SilentlyContinue; Start-Process explorer; Write-Host ''Icon cache rebuilt.'' -ForegroundColor Green' }
      @{ Id='repair_start_menu'; Title='Repair Start Menu'; Desc='Re-register the Start Menu and Shell Experience packages.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Get-AppxPackage -AllUsers Microsoft.Windows.ShellExperienceHost,Microsoft.Windows.StartMenuExperienceHost | ForEach-Object { Add-AppxPackage -DisableDevelopmentMode -Register "$($_.InstallLocation)\AppxManifest.xml" -ErrorAction SilentlyContinue }; Stop-Process -Name StartMenuExperienceHost -Force -ErrorAction SilentlyContinue; Write-Host ''Start Menu re-registered.'' -ForegroundColor Green' }
      @{ Id='reset_local_gpo'; Title='Reset Local Group Policy'; Desc='Remove local Group Policy (registry.pol) and refresh ? fixes GPO corruption.'; Kind='run'; Admin=$true; Danger=$true; Cmd='Remove-Item "$env:SystemRoot\System32\GroupPolicy\Machine\registry.pol" -Force -ErrorAction SilentlyContinue; Remove-Item "$env:SystemRoot\System32\GroupPolicy\User\registry.pol" -Force -ErrorAction SilentlyContinue; Remove-Item "$env:SystemRoot\System32\GroupPolicyUsers" -Recurse -Force -ErrorAction SilentlyContinue; gpupdate /force; Write-Host ''Local Group Policy reset.'' -ForegroundColor Green' }
      @{ Id='reset_hosts_file'; Title='Reset Hosts File'; Desc='Restore the hosts file to default (backs up the old one as hosts.bak).'; Kind='run'; Admin=$true; Danger=$true; Cmd='$h="$env:SystemRoot\System32\drivers\etc\hosts"; Copy-Item $h "$h.bak" -Force -ErrorAction SilentlyContinue; Set-Content -Encoding ascii -Path $h -Value ''# Reset by WindowsOptimizer'',''127.0.0.1       localhost'',''::1             localhost''; Write-Host ''Hosts file reset (backup: hosts.bak).'' -ForegroundColor Green' }
      @{ Id='cycle_network_adapters'; Title='Cycle Network Adapters'; Desc='Disable then re-enable active network adapters (briefly drops connectivity).'; Kind='run'; Admin=$true; Danger=$true; Cmd='Get-NetAdapter | Where-Object Status -eq ''Up'' | ForEach-Object { Write-Host "Cycling $($_.Name)..."; Disable-NetAdapter -Name $_.Name -Confirm:$false; Start-Sleep -Seconds 2; Enable-NetAdapter -Name $_.Name -Confirm:$false }; Write-Host ''Network adapters cycled.'' -ForegroundColor Green' }
      @{ Id='reclaim_disk_space'; Title='Reclaim Disk Space (deep)'; Desc='Component store cleanup + ResetBase ? shrinks WinSxS (updates can no longer be uninstalled).'; Kind='run'; Admin=$true; Danger=$true; Cmd='DISM /Online /Cleanup-Image /StartComponentCleanup /ResetBase; Write-Host ''Component store cleaned (ResetBase).'' -ForegroundColor Green' }
      @{ Id='rebuild_perf_counters'; Title='Rebuild Performance Counters'; Desc='Fix broken Task Manager / perfmon / monitoring graphs.'; Kind='run'; Admin=$true; Danger=$false; Cmd='lodctr /R; winmgmt /resyncperf; Write-Host ''Performance counters rebuilt.'' -ForegroundColor Green' }
      @{ Id='enable_dotnet35'; Title='Enable .NET 3.5'; Desc='Enable the .NET Framework 3.5 feature for legacy apps (needs internet or media).'; Kind='run'; Admin=$true; Danger=$false; Cmd='DISM /Online /Enable-Feature /FeatureName:NetFx3 /All /NoRestart; Write-Host ''.NET Framework 3.5 enabled.'' -ForegroundColor Green' }
      @{ Id='clear_credential_manager'; Title='Clear Credential Manager'; Desc='Purge stored Windows credentials (fixes stale creds / repeated auth prompts).'; Kind='run'; Admin=$true; Danger=$true; Cmd='cmdkey /list | ForEach-Object { if($_ -match ''Target: (.+)''){ cmdkey /delete:($Matches[1].Trim()) | Out-Null } }; Write-Host ''Credential Manager cleared.'' -ForegroundColor Green' }
      @{ Id='reset_notifications'; Title='Reset Notifications'; Desc='Reset the Action Center / notification database.'; Kind='run'; Admin=$true; Danger=$true; Cmd='Get-Process ShellExperienceHost -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Remove-Item "$env:LOCALAPPDATA\Microsoft\Windows\Notifications\wpndatabase.db" -Force -ErrorAction SilentlyContinue; Write-Host ''Notification database reset. Sign out/in to finish.'' -ForegroundColor Green' }
      @{ Id='reset_windows_hello'; Title='Reset Windows Hello (PIN)'; Desc='Clear the Ngc store so the PIN / Hello can be re-enrolled (fixes broken PIN sign-in).'; Kind='run'; Admin=$true; Danger=$true; Cmd='$ngc=''C:\Windows\ServiceProfiles\LocalService\AppData\Local\Microsoft\Ngc''; takeown /f $ngc /r /d y | Out-Null; icacls $ngc /grant administrators:F /t | Out-Null; Remove-Item "$ngc\*" -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''Windows Hello reset. Re-enroll at next sign-in.'' -ForegroundColor Green' }
      @{ Id='clear_wer'; Title='Clear Error Reports'; Desc='Clear the Windows Error Reporting queue and archive.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Remove-Item "$env:ProgramData\Microsoft\Windows\WER\ReportQueue\*" -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item "$env:ProgramData\Microsoft\Windows\WER\ReportArchive\*" -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''Error Reporting queue cleared.'' -ForegroundColor Green' }
      @{ Id='reset_default_apps'; Title='Default Apps Settings'; Desc='Open Default Apps to reset file associations.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ms-settings:defaultapps' }
      @{ Id='repair_uwp_app'; Title='Repair a Store App'; Desc='Re-register a specific UWP/Store app by name (e.g. Photos, Calculator).'; Kind='run'; Admin=$true; Danger=$false; Cmd='Get-AppxPackage ''*{{name}}*'' | ForEach-Object { Add-AppxPackage -DisableDevelopmentMode -Register "$($_.InstallLocation)\AppxManifest.xml" -ErrorAction SilentlyContinue }; Write-Host ''App re-registered.'' -ForegroundColor Green'; Inputs=@(@{ Key='name'; Label='App name contains'; Placeholder='Photos' }) }
    ) }
    @{ Group='REPAIR'; Name='Network'; Id='network'; Tasks=@(
      @{ Id='flush_dns'; Title='Flush DNS'; Desc='Clear the DNS resolver cache.'; Kind='run'; Admin=$false; Danger=$false; Cmd='Clear-DnsClientCache; ipconfig /flushdns' }
      @{ Id='release_renew_ip'; Title='Release / Renew IP'; Desc='Release and renew the DHCP lease.'; Kind='run'; Admin=$true; Danger=$false; Cmd='ipconfig /release; ipconfig /renew' }
      @{ Id='reset_tcp_ip'; Title='Reset TCP/IP'; Desc='Reset the TCP/IP stack to defaults.'; Kind='run'; Admin=$true; Danger=$false; Cmd='netsh int ip reset' }
      @{ Id='winsock_reset'; Title='Winsock Reset'; Desc='Rebuild the Winsock catalog.'; Kind='run'; Admin=$true; Danger=$false; Cmd='netsh winsock reset' }
      @{ Id='reset_network_configurations'; Title='Reset Network'; Desc='Full reset: Winsock, TCP/IP, firewall, DNS and DHCP.'; Kind='run'; Admin=$true; Danger=$true; Cmd='netsh winsock reset; netsh int ip reset; netsh advfirewall reset; ipconfig /release; ipconfig /renew; ipconfig /flushdns; Write-Host ''Network stack reset. Restart recommended.'' -ForegroundColor Green' }
      @{ Id='ip_configuration'; Title='IP Configuration'; Desc='Show full IP configuration (ipconfig /all).'; Kind='report'; Admin=$false; Danger=$false; Cmd='ipconfig /all' }
      @{ Id='test_connection'; Title='Test Connection'; Desc='Ping a host to test connectivity.'; Kind='report'; Admin=$false; Danger=$false; Cmd='Test-Connection -ComputerName ''{{host}}'' -Count 4 | Format-Table -AutoSize'; Inputs=@(@{ Key='host'; Label='Host / IP'; Placeholder='8.8.8.8' }) }
      @{ Id='set_network_private'; Title='Set Network to Private'; Desc='Set active networks to Private (enables discovery and file/printer sharing).'; Kind='run'; Admin=$true; Danger=$false; Cmd='Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private; Write-Host ''Network set to Private.'' -ForegroundColor Green' }
    ) }
    @{ Group='REPAIR'; Name='Troubleshooters'; Id='troubleshooters'; Tasks=@(
      @{ Id='fix_audio_sound_issues'; Title='Fix Audio / Sound'; Desc='Restart the Windows Audio services.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Restart-Service Audiosrv -Force; Restart-Service AudioEndpointBuilder -Force; Write-Host ''Audio services restarted.'' -ForegroundColor Green' }
      @{ Id='fix_bluetooth_issues'; Title='Fix Bluetooth'; Desc='Restart the Bluetooth support service.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Restart-Service bthserv -Force; Write-Host ''Bluetooth service restarted.'' -ForegroundColor Green' }
      @{ Id='fix_hardware_detection_issues'; Title='Fix Hardware Detection'; Desc='Rescan for new / disconnected hardware.'; Kind='run'; Admin=$true; Danger=$false; Cmd='pnputil /scan-devices; Write-Host ''Hardware rescan complete.'' -ForegroundColor Green' }
      @{ Id='audio_troubleshooter'; Title='Audio Troubleshooter'; Desc='Windows audio playback troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:troubleshoot''' }
      @{ Id='bluetooth_troubleshooter'; Title='Bluetooth Troubleshooter'; Desc='Open the Bluetooth troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:troubleshoot''' }
      @{ Id='bits_troubleshooter'; Title='Restart BITS'; Desc='Restart the Background Intelligent Transfer Service (fixes stuck updates).'; Kind='run'; Admin=$true; Danger=$false; Cmd='Restart-Service BITS -Force; Write-Host ''BITS restarted.'' -ForegroundColor Green' }
      @{ Id='camera_troubleshooter'; Title='Camera Troubleshooter'; Desc='Open the camera troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:troubleshoot''' }
      @{ Id='network_internet_troubleshooter'; Title='Network Troubleshooter'; Desc='Network adapter troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:network-status''' }
      @{ Id='printer_troubleshooter'; Title='Printer Troubleshooter'; Desc='Diagnose printing problems.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:printers''' }
      @{ Id='program_compatibility_troubleshooter'; Title='Program Compatibility'; Desc='Program compatibility troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process msdt.exe -ArgumentList ''/id PCWDiagnostic''' }
      @{ Id='video_playback_troubleshooter'; Title='Video Playback'; Desc='Video playback troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:troubleshoot''' }
      @{ Id='windows_media_player_troubleshooter'; Title='Media Player'; Desc='Windows Media Player settings troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:troubleshoot''' }
      @{ Id='windows_update_troubleshooter'; Title='Windows Update'; Desc='Windows Update troubleshooter.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process ''ms-settings:troubleshoot''' }
    ) }
    @{ Group='REPAIR'; Name='Cleanup'; Id='cleanup'; Tasks=@(
      @{ Id='clear_user_temp'; Title='Clear User Temp'; Desc='Delete the current user''s temp files.'; Kind='run'; Admin=$false; Danger=$false; Cmd='Get-ChildItem $env:TEMP -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''User temp cleared.'' -ForegroundColor Green' }
      @{ Id='clear_windows_temp'; Title='Clear Windows Temp'; Desc='Delete the system-wide Windows temp files.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Get-ChildItem ''C:\Windows\Temp'' -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''Windows temp cleared.'' -ForegroundColor Green' }
      @{ Id='clear_windows_update_cache'; Title='Clear Update Cache'; Desc='Stop services and clear the Windows Update download cache.'; Kind='run'; Admin=$true; Danger=$true; Cmd='net stop wuauserv; net stop bits; Remove-Item ''C:\Windows\SoftwareDistribution\Download\*'' -Recurse -Force -ErrorAction SilentlyContinue; net start wuauserv; net start bits; Write-Host ''Update cache cleared.'' -ForegroundColor Green' }
      @{ Id='clear_ms_store_cache'; Title='Clear Store Cache'; Desc='Reset the Microsoft Store cache (wsreset).'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process wsreset.exe' }
      @{ Id='clear_ms_teams_cache'; Title='Clear Teams Cache'; Desc='Close Teams and clear its cache.'; Kind='run'; Admin=$false; Danger=$true; Cmd='Get-Process ms-teams,Teams -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Remove-Item "$env:APPDATA\Microsoft\Teams\*" -Recurse -Force -ErrorAction SilentlyContinue; Get-ChildItem "$env:LOCALAPPDATA\Packages" -Filter ''MSTeams_*'' -ErrorAction SilentlyContinue | ForEach-Object { Remove-Item "$($_.FullName)\LocalCache\*" -Recurse -Force -ErrorAction SilentlyContinue }; Write-Host ''Teams cache cleared.'' -ForegroundColor Green' }
      @{ Id='clear_ms_outlook_cache'; Title='Clear Outlook Cache'; Desc='Clear the Outlook roaming cache.'; Kind='run'; Admin=$false; Danger=$true; Cmd='Remove-Item "$env:LOCALAPPDATA\Microsoft\Outlook\RoamCache\*" -Force -ErrorAction SilentlyContinue; Write-Host ''Outlook cache cleared.'' -ForegroundColor Green' }
      @{ Id='clear_thumbnail_cache'; Title='Clear Thumbnails'; Desc='Rebuild the Explorer thumbnail cache.'; Kind='run'; Admin=$false; Danger=$false; Cmd='Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue; Remove-Item "$env:LOCALAPPDATA\Microsoft\Windows\Explorer\thumbcache_*.db" -Force -ErrorAction SilentlyContinue; Start-Process explorer; Write-Host ''Thumbnail cache cleared.'' -ForegroundColor Green' }
      @{ Id='clear_recycle_bin'; Title='Empty Recycle Bin'; Desc='Permanently empty the Recycle Bin.'; Kind='run'; Admin=$false; Danger=$true; Cmd='Clear-RecycleBin -Force -ErrorAction SilentlyContinue; Write-Host ''Recycle Bin emptied.'' -ForegroundColor Green' }
      @{ Id='disk_cleanup'; Title='Disk Cleanup'; Desc='Open the Windows Disk Cleanup tool.'; Kind='launch'; Admin=$false; Danger=$false; Cmd='Start-Process cleanmgr.exe' }
      @{ Id='delete_temporary_internet_files'; Title='Temp Internet Files'; Desc='Clear cached internet files.'; Kind='run'; Admin=$false; Danger=$false; Cmd='Remove-Item "$env:LOCALAPPDATA\Microsoft\Windows\INetCache\*" -Recurse -Force -ErrorAction SilentlyContinue; RunDll32.exe InetCpl.cpl,ClearMyTracksByProcess 8; Write-Host ''Temporary internet files cleared.'' -ForegroundColor Green' }
      @{ Id='delete_old_windows'; Title='Delete Windows.old'; Desc='Remove the previous Windows installation folder.'; Kind='run'; Admin=$true; Danger=$true; Cmd='cmd /c "takeown /F C:\Windows.old\* /R /A /D Y & icacls C:\Windows.old\*.* /T /grant administrators:F & rmdir /S /Q C:\Windows.old"; Write-Host ''Windows.old removed (if present).'' -ForegroundColor Green' }
      @{ Id='delete_system_restore_points'; Title='Delete Restore Points'; Desc='Delete all system restore points and shadow copies.'; Kind='run'; Admin=$true; Danger=$true; Cmd='vssadmin delete shadows /all /quiet; Write-Host ''Restore points deleted.'' -ForegroundColor Green' }
      @{ Id='securely_wipe_free_space'; Title='Wipe Free Space'; Desc='Securely overwrite free space on C: (can take a while).'; Kind='run'; Admin=$true; Danger=$true; Cmd='cipher /w:C:\' }
      @{ Id='perform_defragmentation'; Title='Defragment C:'; Desc='Optimize / defragment the C: volume.'; Kind='run'; Admin=$true; Danger=$false; Cmd='Optimize-Volume -DriveLetter C -Defrag -Verbose' }
    ) }
    @{ Group='SYSTEM'; Name='Privacy'; Id='privacy'; Tasks=@(
      @{ Id='delete_address_bar_history'; Title='Address Bar History'; Desc='Clear Explorer''s typed-paths history.'; Kind='run'; Admin=$false; Danger=$false; Cmd='Remove-Item ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\TypedPaths'' -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''Address bar history cleared.'' -ForegroundColor Green' }
      @{ Id='delete_recent_items_history'; Title='Recent Items'; Desc='Clear the Recent Items list.'; Kind='run'; Admin=$false; Danger=$false; Cmd='Remove-Item "$env:APPDATA\Microsoft\Windows\Recent\*" -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''Recent items cleared.'' -ForegroundColor Green' }
      @{ Id='delete_run_history'; Title='Run History'; Desc='Clear the Run dialog (RunMRU) history.'; Kind='run'; Admin=$false; Danger=$false; Cmd='Remove-Item ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\RunMRU'' -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ''Run history cleared.'' -ForegroundColor Green' }
    ) }
    @{ Group='SYSTEM'; Name='Tweaks'; Id='tweaks'; Tasks=@(
      @{ Id='telemetry'; Title='Telemetry'; Desc='Windows diagnostic data collection (DiagTrack).'; Kind='toggle'; Admin=$true; Danger=$false; Enable='Set-ItemProperty ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection'' -Name AllowTelemetry -Value 1 -Type DWord -ErrorAction SilentlyContinue; Set-Service DiagTrack -StartupType Automatic -ErrorAction SilentlyContinue; Start-Service DiagTrack -ErrorAction SilentlyContinue; Write-Host ''Telemetry enabled.'' -ForegroundColor Green'; Disable='New-Item ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection'' -Force | Out-Null; Set-ItemProperty ''HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection'' -Name AllowTelemetry -Value 0 -Type DWord; Set-Service DiagTrack -StartupType Disabled -ErrorAction SilentlyContinue; Stop-Service DiagTrack -Force -ErrorAction SilentlyContinue; Write-Host ''Telemetry disabled.'' -ForegroundColor Green'; Check='if((Get-Service DiagTrack -EA SilentlyContinue).Status -eq ''Running''){''ON''}else{''OFF''}' }
      @{ Id='personalized_ads'; Title='Personalized Ads'; Desc='Advertising ID used for personalized ads.'; Kind='toggle'; Admin=$false; Danger=$false; Enable='Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo'' -Name Enabled -Value 1 -Type DWord; Write-Host ''Personalized ads enabled.'' -ForegroundColor Green'; Disable='New-Item ''HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo'' -Force | Out-Null; Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo'' -Name Enabled -Value 0 -Type DWord; Write-Host ''Personalized ads disabled.'' -ForegroundColor Green'; Check='if((&{try{(Get-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo'' -EA Stop).Enabled}catch{1}}) -ne 0){''ON''}else{''OFF''}' }
      @{ Id='ads_from_file_explorer'; Title='File Explorer Ads'; Desc='Sync-provider promotional ads in File Explorer.'; Kind='toggle'; Admin=$false; Danger=$false; Enable='Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'' -Name ShowSyncProviderNotifications -Value 1 -Type DWord; Write-Host ''File Explorer ads enabled.'' -ForegroundColor Green'; Disable='Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'' -Name ShowSyncProviderNotifications -Value 0 -Type DWord; Write-Host ''File Explorer ads disabled.'' -ForegroundColor Green'; Check='if((&{try{(Get-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'' -EA Stop).ShowSyncProviderNotifications}catch{1}}) -ne 0){''ON''}else{''OFF''}' }
      @{ Id='lock_screen_ads'; Title='Lock Screen Ads'; Desc='Spotlight / promotional content on the lock screen.'; Kind='toggle'; Admin=$false; Danger=$false; Enable='Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'' -Name RotatingLockScreenOverlayEnabled -Value 1 -Type DWord; Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'' -Name SubscribedContent-338387Enabled -Value 1 -Type DWord; Write-Host ''Lock screen ads enabled.'' -ForegroundColor Green'; Disable='Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'' -Name RotatingLockScreenOverlayEnabled -Value 0 -Type DWord; Set-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'' -Name SubscribedContent-338387Enabled -Value 0 -Type DWord; Write-Host ''Lock screen ads disabled.'' -ForegroundColor Green'; Check='if((&{try{(Get-ItemProperty ''HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'' -EA Stop).RotatingLockScreenOverlayEnabled}catch{1}}) -ne 0){''ON''}else{''OFF''}' }
