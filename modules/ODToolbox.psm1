<#
    ODToolbox.psm1 - Repair & maintenance suite. Tasks are declared in
    data/toolbox.psd1 (house-style data file) and run real PowerShell commands
    (run / launch / report / toggle / special), grouped by category.
    Part of WindowsOptimizer.
#>

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Get-ODMyToolsDir {
    return (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'WindowsOptimizer\MyTools')
}

# Substitute {{key}} placeholders (and the special {{minutes_seconds}}) in a command.
function Expand-ODTaskCmd {
    param([string]$Cmd, $Inputs)
    if ([string]::IsNullOrEmpty($Cmd)) { return $Cmd }
    $values = @{}
    if ($Inputs) {
        foreach ($inp in $Inputs) {
            $label = if ($inp.Placeholder) { "{0} (e.g. {1})" -f $inp.Label, $inp.Placeholder } else { $inp.Label }
            $values[$inp.Key] = Read-ODLine ("  {0}: " -f $label)
        }
    }
    $out = $Cmd
    foreach ($k in $values.Keys) { $out = $out.Replace("{{$k}}", $values[$k]) }
    if ($out -match '\{\{minutes_seconds\}\}') {
        $mins = 0; if ($values.ContainsKey('minutes')) { [void][int]::TryParse([string]$values['minutes'], [ref]$mins) }
        $out = $out.Replace('{{minutes_seconds}}', [string]($mins * 60))
    }
    return $out
}

# Run a raw PowerShell command string in-process, honouring dry-run.
function Invoke-ODToolboxCmd {
    param([string]$Cmd, [string]$Label)
    if ([string]::IsNullOrWhiteSpace($Cmd)) { Write-ODWarn "  (no command for this task)"; return }
    if (Test-ODDryRun) {
        Write-Host "  (DRY-RUN) would run:" -ForegroundColor Cyan
        Write-Host ("    " + $Cmd) -ForegroundColor DarkGray
        return
    }
    Write-ODLog ("TOOLBOX run: {0}" -f $Label) 'CHANGE'
    Write-Host ""
    try { Invoke-Expression $Cmd }
    catch { Write-ODError ("  Task error: {0}" -f $_.Exception.Message); Write-ODLog ("TOOLBOX error in {0}: {1}" -f $Label, $_.Exception.Message) 'ERROR' }
}

function Invoke-ODToolboxSpecial {
    param($Task)
    $myTools = Get-ODMyToolsDir
    switch ($Task.Action) {
        'open_mytools' {
            if (-not (Test-ODDryRun)) { New-Item -ItemType Directory -Force -Path $myTools | Out-Null; Start-Process explorer.exe $myTools }
            Write-ODOk ("  MyTools: {0}" -f $myTools)
        }
        'one_click' {
            if (-not (Test-ODDryRun)) {
                New-Item -ItemType Directory -Force -Path $myTools | Out-Null
                $script = @'
# One-Click Maintenance (generated by WindowsOptimizer)
Write-Host "Clearing temp..."; Get-ChildItem $env:TEMP -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
Write-Host "Flushing DNS..."; Clear-DnsClientCache; ipconfig /flushdns
Write-Host "SFC..."; sfc /scannow
Write-Host "Done." -ForegroundColor Green
'@
                $path = Join-Path $myTools 'OneClickMaintenance.ps1'
                Set-Content -Path $path -Value $script -Encoding ASCII
                Write-ODOk ("  Wrote {0}" -f $path)
            } else { Write-Host "  (DRY-RUN) would write OneClickMaintenance.ps1 to MyTools" -ForegroundColor Cyan }
        }
        'unlock_mytools' {
            if (-not (Test-ODDryRun)) { New-Item -ItemType Directory -Force -Path $myTools | Out-Null; & icacls $myTools /reset /T /C | Out-Null }
            Write-ODOk "  MyTools permissions reset."
        }
        'schedule_maintenance' {
            $action = 'powershell.exe -NoProfile -Command "Get-ChildItem $env:TEMP -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Clear-DnsClientCache"'
            if (-not (Test-ODDryRun)) {
                & schtasks /Create /SC WEEKLY /D SUN /TN 'WindowsOptimizer Weekly Maintenance' /TR $action /ST 12:00 /F | Out-Null
                Write-ODOk "  Weekly maintenance task created (Sundays 12:00)."
            } else { Write-Host "  (DRY-RUN) would create a weekly scheduled task" -ForegroundColor Cyan }
        }
        'remove_ms_accounts' {
            # Sign out of all work/school (WAM) accounts and clear cached Office/M365
            # licenses using Microsoft's official OLicenseCleanup + signoutofwamaccounts tools.
            $urls = @{
                'OLicenseCleanup.vbs'      = 'https://download.microsoft.com/download/e/1/b/e1bbdc16-fad4-4aa2-a309-2ba3cae8d424/OLicenseCleanup.zip'
                'signoutofwamaccounts.ps1' = 'https://download.microsoft.com/download/f/8/7/f8745d3b-49ad-4eac-b49a-2fa60b929e7d/signoutofwamaccounts.zip'
            }
            if (Test-ODDryRun) {
                Write-Host "  (DRY-RUN) would download Microsoft's cleanup tools and run OLicenseCleanup.vbs:" -ForegroundColor Cyan
                foreach ($u in $urls.Values) { Write-Host ("    " + $u) -ForegroundColor DarkGray }
                return
            }
            $folder = Join-Path $env:LOCALAPPDATA ('OfficeReset-' + (Get-Date -Format 'yyyyMMdd-HHmmss'))
            New-Item -ItemType Directory -Path $folder -Force | Out-Null
            try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}
            foreach ($name in $urls.Keys) {
                $existing = Get-ChildItem -LiteralPath $folder -Recurse -File -Filter $name -ErrorAction SilentlyContinue | Select-Object -First 1
                if (-not $existing) {
                    $zip = Join-Path $folder ($name + '.zip')
                    Write-Host ("  Downloading {0}..." -f $name) -ForegroundColor Cyan
                    Invoke-WebRequest -Uri $urls[$name] -OutFile $zip -UseBasicParsing
                    Expand-Archive -LiteralPath $zip -DestinationPath $folder -Force
                }
            }
            $vbs = Get-ChildItem -LiteralPath $folder -Recurse -File -Filter 'OLicenseCleanup.vbs' | Select-Object -First 1
            $wam = Get-ChildItem -LiteralPath $folder -Recurse -File -Filter 'signoutofwamaccounts.ps1' | Select-Object -First 1
            if (-not $vbs -or -not $wam) { throw "One or both Microsoft scripts are missing after extraction. Inspect: $folder" }
            $destination = Join-Path $vbs.DirectoryName 'signoutofwamaccounts.ps1'
            if ($wam.FullName -ne $destination) { Copy-Item -LiteralPath $wam.FullName -Destination $destination -Force }
            Push-Location -LiteralPath $vbs.DirectoryName
            try {
                & "$env:SystemRoot\System32\cscript.exe" //nologo $vbs.FullName
                if ($LASTEXITCODE -ne 0) { throw "Cleanup returned exit code $LASTEXITCODE. Review the output above." }
                Write-ODOk "  Microsoft account + Office license cleanup complete."
            } finally { Pop-Location }
        }
        default { Write-ODWarn ("  Unknown special action: {0}" -f $Task.Action) }
    }
}

function Invoke-ODToolboxTask {
    param($Task)
    Show-ODBanner
    $flags = @()
    if ($Task.Admin)  { $flags += 'ADMIN' }
    if ($Task.Danger) { $flags += 'DESTRUCTIVE' }
    $flagStr = if ($flags) { "  [" + ($flags -join ', ') + "]" } else { '' }
    Write-ODTitle ("  {0}{1}" -f $Task.Title, $flagStr)
    if ($Task.Desc) { Write-Host ("  {0}" -f $Task.Desc) -ForegroundColor Gray }
    Write-Host ""

    if ($Task.Kind -eq 'special') {
        if ($Task.Danger) {
            Write-ODWarn "  This is a destructive / high-impact action."
            if (Test-ODDryRun) { Write-Host "  (DRY-RUN on - it will only be described.)" -ForegroundColor Cyan }
            if ((Read-ODLine "  Type ARM to confirm: ").Trim() -ne 'ARM') { Write-ODInfo "  Cancelled."; Invoke-ODPause; return }
        }
        Invoke-ODToolboxSpecial -Task $Task
        Invoke-ODPause; return
    }

    if ($Task.Kind -eq 'toggle') {
        $state = '?'
        if ($Task.Check) { try { $state = (Invoke-Expression $Task.Check) } catch { $state = '?' } }
        $stateColor = if ($state -eq 'ON') { 'Green' } else { 'DarkGray' }
        Write-Host ("  Current state: {0}" -f $state) -ForegroundColor $stateColor
        Write-Host "   1. Enable" -ForegroundColor Green
        Write-Host "   2. Disable" -ForegroundColor Yellow
        Write-Host "   0. Back" -ForegroundColor DarkGray
        $c = Read-ODLine "  Choose: "
        $cmd = $null; $verb = $null
        switch ($c.Trim()) {
            '1' { $cmd = $Task.Enable;  $verb = 'enable' }
            '2' { $cmd = $Task.Disable; $verb = 'disable' }
            default { return }
        }
        if ($Task.Danger) {
            Write-ODWarn "  This is a destructive / high-impact change."
            if ((Read-ODLine "  Type ARM to confirm: ").Trim() -ne 'ARM') { Write-ODInfo "  Cancelled."; Invoke-ODPause; return }
        }
        Invoke-ODToolboxCmd -Cmd $cmd -Label ("{0} [{1}]" -f $Task.Title, $verb)
        Invoke-ODPause; return
    }

    # run / launch / report
    if ($Task.Danger) {
        Write-ODWarn "  This task is DESTRUCTIVE or high-impact."
        if (Test-ODDryRun) { Write-Host "  (DRY-RUN on - it will only be printed.)" -ForegroundColor Cyan }
        if ((Read-ODLine "  Type ARM to confirm: ").Trim() -ne 'ARM') { Write-ODInfo "  Cancelled."; Invoke-ODPause; return }
    } else {
        if (-not (Confirm-ODAction "  Run this task?")) { Write-ODInfo "  Cancelled."; Invoke-ODPause; return }
    }
    $cmd = Expand-ODTaskCmd -Cmd $Task.Cmd -Inputs $Task.Inputs
    Invoke-ODToolboxCmd -Cmd $cmd -Label $Task.Title
    Invoke-ODPause
}

function Invoke-ODToolboxCategory {
    param($Group)
    while ($true) {
        Show-ODBanner
        Write-ODTitle ("  TOOLBOX > {0}" -f $Group.Name)
        Write-Host ""
        $n = 0; $map = @{}
        foreach ($t in $Group.Tasks) {
            $n++; $map[$n] = $t
            $tags = @()
            if ($t.Admin)  { $tags += 'admin' }
            if ($t.Danger) { $tags += 'destructive' }
            $suffix = if ($tags) { "  (" + ($tags -join ', ') + ")" } else { '' }
            $kindTag = switch ($t.Kind) { 'launch' {'[open] '} 'report' {'[info] '} 'toggle' {'[toggle] '} 'special' {'[*] '} default {''} }
            Write-Host ("   {0,3}. " -f $n) -NoNewline -ForegroundColor White
            Write-Host ("{0}{1}" -f $kindTag, $t.Title) -NoNewline -ForegroundColor White
            Write-Host $suffix -ForegroundColor DarkGray
            Write-ODItemDesc $t.Desc
        }
        Write-Host ""
        Write-Host "  Enter a task number, or 0 to go back." -ForegroundColor DarkGray
        $sel = Read-ODLine "  Selection: "
        if ($sel.Trim() -eq '0' -or [string]::IsNullOrWhiteSpace($sel)) { return }
        if ($sel -notmatch '^\d+$' -or -not $map.ContainsKey([int]$sel)) { continue }
        Invoke-ODToolboxTask -Task $map[[int]$sel]
    }
}

function Invoke-ODToolboxMenu {
    $groups = Get-ODToolbox
    $total = ($groups | ForEach-Object { $_.Tasks.Count } | Measure-Object -Sum).Sum
    while ($true) {
        Show-ODBanner
        Write-ODTitle "  TOOLBOX  (repair & maintenance)"
        Write-Host ("  {0} tasks. Pick a category." -f $total) -ForegroundColor DarkGray
        Write-Host ""
        $n = 0; $map = @{}
        $lastGroup = ''
        foreach ($g in $groups) {
            $grp = if ($g.Group) { $g.Group } else { 'OTHER' }
            if ($grp -ne $lastGroup) {
                Write-Host ""
                Write-Host ("  == {0} ==" -f $grp) -ForegroundColor Cyan
                $lastGroup = $grp
            }
            $n++; $map[$n] = $g
            Write-Host ("   {0,3}. {1,-26} ({2} tasks)" -f $n, $g.Name, $g.Tasks.Count) -ForegroundColor White
        }
        Write-Host ""
        Write-Host "  Enter a category number, or 0 to go back." -ForegroundColor DarkGray
        $sel = Read-ODLine "  Selection: "
        if ($sel.Trim() -eq '0' -or [string]::IsNullOrWhiteSpace($sel)) { return }
        if ($sel -notmatch '^\d+$' -or -not $map.ContainsKey([int]$sel)) { continue }
        Invoke-ODToolboxCategory -Group $map[[int]$sel]
    }
}

Export-ModuleMember -Function *
